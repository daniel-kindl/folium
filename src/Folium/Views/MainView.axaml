<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Folium.ViewModels"
             x:Class="Folium.Views.MainView"
             x:DataType="vm:LibraryViewModel">
    <Grid Margin="16" RowDefinitions="Auto,*">
        <TextBlock Text="{Binding Heading}" FontSize="28" TextWrapping="Wrap" />
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid IsVisible="{Binding ShowLibrary}" RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Content="All"
                                Command="{Binding FilterCommand}"
                                CommandParameter="all"
                                MinHeight="48"
                                Margin="0,0,8,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Content="To read"
                                Command="{Binding FilterCommand}"
                                CommandParameter="to-read"
                                MinHeight="48"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Content="Reading"
                                Command="{Binding FilterCommand}"
                                CommandParameter="reading"
                                MinHeight="48"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Content="Finished"
                                Command="{Binding FilterCommand}"
                                CommandParameter="finished"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding FilterLabel}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ShowFilterLabel}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Text="{Binding EmptyMessage}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsEmpty}" />
                <TextBlock Grid.Row="1"
                           Text="{Binding NoMatchMessage}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ShowNoMatches}" />
                <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowBooks}">
                    <ItemsControl ItemsSource="{Binding ShownBooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookRow">
                                <Button MinHeight="48"
                                        Margin="0,0,0,8"
                                        Padding="12,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Command="{Binding $parent[vm:LibraryViewModel].OpenCommand}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Author}" FontSize="16" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Status}" FontSize="16" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2"
                        Content="Add a book"
                        Command="{Binding ShowAddCommand}"
                        MinHeight="48"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </Grid>

            <ScrollViewer IsVisible="{Binding ShowEditor}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Title" FontSize="16" />
                    <TextBox Text="{Binding TitleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="48"
                             AutomationProperties.Name="Title" />
                    <TextBlock Text="Author" FontSize="16" />
                    <TextBox Text="{Binding AuthorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="48"
                             AutomationProperties.Name="Author" />
                    <TextBlock Text="{Binding InputError}" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SaveError}" FontSize="16" TextWrapping="Wrap" />
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </ScrollViewer>

            <Grid IsVisible="{Binding ShowDetails}" RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Title" FontSize="16" />
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock Text="Author" FontSize="16" />
                        <TextBlock Text="{Binding SelectedAuthor}" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock Text="Status" FontSize="16" />
                        <TextBlock Text="{Binding SelectedStatus}" FontSize="16" TextWrapping="Wrap" />
                        <Button Content="To read"
                                Command="{Binding SetStatusCommand}"
                                CommandParameter="to-read"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Reading"
                                Command="{Binding SetStatusCommand}"
                                CommandParameter="reading"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Finished"
                                Command="{Binding SetStatusCommand}"
                                CommandParameter="finished"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
                    <Button Content="Edit"
                            Command="{Binding EditCommand}"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Button Content="Remove"
                            Command="{Binding AskRemoveCommand}"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel IsVisible="{Binding ShowConfirm}" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedTitle}" FontSize="20" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConfirmMessage}" FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SaveError}" FontSize="16" TextWrapping="Wrap" />
                <Button Content="Remove book"
                        Command="{Binding ConfirmRemoveCommand}"
                        MinHeight="48"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Content="Keep book"
                        Command="{Binding KeepBookCommand}"
                        MinHeight="48"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding LoadError}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ShowLoadError}" />
        </Grid>
    </Grid>
</UserControl>
