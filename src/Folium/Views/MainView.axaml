<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Folium.ViewModels"
             xmlns:views="using:Folium.Views"
             x:Class="Folium.Views.MainView"
             x:DataType="vm:LibraryViewModel">
    <Grid Margin="16" RowDefinitions="Auto,*">
        <TextBlock Text="{Binding Heading}" FontSize="28" TextWrapping="Wrap" />
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid IsVisible="{Binding ShowLibrary}" RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="8">
                    <Button Content="Find a book online" Command="{Binding ShowSearchCommand}" MinHeight="48" HorizontalAlignment="Stretch" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Content="All"
                                Command="{Binding FilterCommand}"
                                CommandParameter="all"
                                MinHeight="48"
                                Margin="0,0,8,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Content="To read"
                                Command="{Binding FilterCommand}"
                                CommandParameter="to-read"
                                MinHeight="48"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Content="Reading"
                                Command="{Binding FilterCommand}"
                                CommandParameter="reading"
                                MinHeight="48"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Content="Finished"
                                Command="{Binding FilterCommand}"
                                CommandParameter="finished"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding FilterLabel}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ShowFilterLabel}" />
                    <TextBlock Text="{Binding SaveError}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SaveError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.Name="{Binding SaveError}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Text="{Binding EmptyMessage}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsEmpty}" />
                <TextBlock Grid.Row="1"
                           Text="{Binding NoMatchMessage}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ShowNoMatches}" />
                <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowBooks}">
                    <ItemsControl ItemsSource="{Binding ShownBooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookRow">
                                <Button MinHeight="48"
                                        Margin="0,0,0,8"
                                        Padding="12,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Command="{Binding $parent[vm:LibraryViewModel].OpenCommand}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Author}" FontSize="16" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Status}" FontSize="16" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2"
                        Content="Add a book"
                        Command="{Binding ShowAddCommand}"
                        MinHeight="48"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </Grid>

            <Grid IsVisible="{Binding ShowSearch}">
                <views:SearchView DataContext="{Binding Search}" />
            </Grid>

            <ScrollViewer IsVisible="{Binding ShowEditor}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Title" FontSize="16" />
                    <TextBox Text="{Binding TitleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="48"
                             AutomationProperties.Name="Title" />
                    <TextBlock Text="Author" FontSize="16" />
                    <TextBox Text="{Binding AuthorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="48"
                             AutomationProperties.Name="Author" />
                    <StackPanel IsVisible="{Binding MetadataEditor, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Spacing="8">
                        <TextBlock Text="Review metadata from Open Library" FontSize="18" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MetadataEditor.EditionKey}" TextWrapping="Wrap" />
                        <TextBlock Text="Publisher" />
                        <TextBox Name="PublisherInput" Text="{Binding MetadataEditor.Publisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" AutomationProperties.Name="Publisher" />
                        <TextBlock Text="Publication date" />
                        <TextBox Name="PublicationDateInput" Text="{Binding MetadataEditor.PublicationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" AutomationProperties.Name="Publication date" />
                        <TextBlock Text="ISBN" />
                        <TextBox Name="IsbnInput" Text="{Binding MetadataEditor.Isbn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" AutomationProperties.Name="ISBN" />
                        <TextBlock Text="Edition" />
                        <TextBox Name="EditionInput" Text="{Binding MetadataEditor.Edition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" AutomationProperties.Name="Edition" />
                        <TextBlock Text="Language" />
                        <TextBox Name="LanguageInput" Text="{Binding MetadataEditor.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" AutomationProperties.Name="Language" />
                        <TextBlock Text="Description" />
                        <TextBox Name="DescriptionInput" Text="{Binding MetadataEditor.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" AutomationProperties.Name="Description" />
                        <CheckBox Name="KeepCoverInput" IsChecked="{Binding MetadataEditor.KeepCover, Mode=TwoWay}" IsVisible="{Binding MetadataEditor.HasCover}" MinHeight="48">
                            <TextBlock Text="I have permission to save this cover on my device" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="Cover images can have separate copyright restrictions. Leave the box unchecked to save without a cover." TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding InputError}" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SaveError}" FontSize="16" TextWrapping="Wrap" />
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </ScrollViewer>

            <Grid IsVisible="{Binding ShowDetails}" RowDefinitions="*,Auto,Auto">
                <ScrollViewer Grid.Row="0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Title" FontSize="16" />
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock Text="Author" FontSize="16" />
                        <TextBlock Text="{Binding SelectedAuthor}" FontSize="16" TextWrapping="Wrap" />
                        <views:LocalCover Name="SavedCover" Bytes="{Binding SelectedCover}" MaxHeight="220" Stretch="Uniform" AutomationProperties.Name="Saved book cover" />
                        <TextBlock Text="No saved cover" IsVisible="{Binding #SavedCover.Source, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                        <StackPanel IsVisible="{Binding HasSelectedMetadata}" Spacing="8">
                            <TextBlock Text="Metadata from Open Library" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedMetadata.WorkKey}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedMetadata.EditionKey}" TextWrapping="Wrap" />
                            <TextBlock Text="Publisher" />
                            <TextBlock Text="{Binding SelectedMetadata.Publisher}" TextWrapping="Wrap" />
                            <TextBlock Text="Publication date" />
                            <TextBlock Text="{Binding SelectedMetadata.PublicationDate}" TextWrapping="Wrap" />
                            <TextBlock Text="ISBN" />
                            <TextBlock Text="{Binding SelectedMetadata.Isbn}" TextWrapping="Wrap" />
                            <TextBlock Text="Edition" />
                            <TextBlock Text="{Binding SelectedMetadata.Edition}" TextWrapping="Wrap" />
                            <TextBlock Text="Language" />
                            <TextBlock Text="{Binding SelectedMetadata.Language}" TextWrapping="Wrap" />
                            <TextBlock Text="Description" />
                            <TextBlock Text="{Binding SelectedMetadata.Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Status" FontSize="16" />
                        <TextBlock Text="{Binding SelectedStatus}" FontSize="16" TextWrapping="Wrap" />
                        <Button Content="To read"
                                Command="{Binding SetStatusCommand}"
                                CommandParameter="to-read"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Reading"
                                Command="{Binding SetStatusCommand}"
                                CommandParameter="reading"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Finished"
                                Command="{Binding SetStatusCommand}"
                                CommandParameter="finished"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="1"
                           Text="{Binding SaveError}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"
                           IsVisible="{Binding SaveError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.Name="{Binding SaveError}"
                           AutomationProperties.LiveSetting="Assertive" />
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                    <Button Content="Edit"
                            Command="{Binding EditCommand}"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Button Content="Remove"
                            Command="{Binding AskRemoveCommand}"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel IsVisible="{Binding ShowConfirm}" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedTitle}" FontSize="20" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConfirmMessage}" FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SaveError}" FontSize="16" TextWrapping="Wrap" />
                <Button Content="Remove book"
                        Command="{Binding ConfirmRemoveCommand}"
                        MinHeight="48"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Content="Keep book"
                        Command="{Binding KeepBookCommand}"
                        MinHeight="48"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding LoadError}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ShowLoadError}" />
        </Grid>
    </Grid>
</UserControl>
