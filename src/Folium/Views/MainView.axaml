<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Folium.ViewModels"
             xmlns:views="using:Folium.Views"
             x:Class="Folium.Views.MainView"
             x:DataType="vm:LibraryViewModel">
    <UserControl.Resources>
        <views:CoverToneBrushConverter x:Key="CoverToneBrush" />
    </UserControl.Resources>
    <Grid Margin="{StaticResource FoliumGutterThickness}" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="1" Margin="{StaticResource FoliumTopSpacingLg}">
            <Grid IsVisible="{Binding ShowLibrary}" RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="{StaticResource FoliumSpacingSm}">
                    <TextBlock Text="{Binding CountLabel}" Classes="folium-label-small" IsVisible="{Binding ShowSavedBookControls}" />
                    <Grid x:Name="FilterGrid"
                          ColumnDefinitions="*,*,*,*"
                          ColumnSpacing="{StaticResource FoliumSpacingSm}"
                          RowSpacing="{StaticResource FoliumSpacingSm}">
                        <Button x:Name="AllFilter"
                                Grid.Column="0"
                                Content="All"
                                Classes="folium-segment"
                                Classes.folium-primary="{Binding IsAllSelected}"
                                Command="{Binding FilterCommand}"
                                CommandParameter="all" />
                        <Button x:Name="ToReadFilter"
                                Grid.Column="1"
                                Content="To read"
                                Classes="folium-segment"
                                Classes.folium-primary="{Binding IsToReadSelected}"
                                Command="{Binding FilterCommand}"
                                CommandParameter="to-read" />
                        <Button x:Name="ReadingFilter"
                                Grid.Column="2"
                                Content="Reading"
                                Classes="folium-segment"
                                Classes.folium-primary="{Binding IsReadingSelected}"
                                Command="{Binding FilterCommand}"
                                CommandParameter="reading" />
                        <Button x:Name="FinishedFilter"
                                Grid.Column="3"
                                Content="Finished"
                                Classes="folium-segment"
                                Classes.folium-primary="{Binding IsFinishedSelected}"
                                Command="{Binding FilterCommand}"
                                CommandParameter="finished" />
                    </Grid>
                    <Button x:Name="StatusFilter"
                            Content="{Binding FilterLabel, TargetNullValue='All', FallbackValue='All'}"
                            Command="{Binding FilterCommand}"
                            IsVisible="False"
                            AutomationProperties.Name="Reading status" />
                    <TextBlock Text="{Binding FilterLabel}"
                               Classes="folium-active-filter folium-label"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ShowFilterLabel}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding SaveError}"
                               Classes="folium-error"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SaveError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.Name="{Binding SaveError}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
                <ScrollViewer x:Name="LibraryContentScroll" Grid.Row="1">
                    <StackPanel Spacing="{StaticResource FoliumSpacingSm}">
                        <StackPanel Spacing="{StaticResource FoliumSpacingSm}" IsVisible="{Binding ShowSavedBookControls}">
                            <Button Content="{Binding SortLabel}"
                                    Command="{Binding ToggleSortMenuCommand}"
                                    AutomationProperties.Name="Sort by"
                                    HorizontalAlignment="Left" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource FoliumSpacingSm}" IsVisible="{Binding ShowSavedSearch}">
                                <TextBox x:Name="LibrarySearchInput"
                                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Search saved books"
                                         AutomationProperties.Name="Search saved books" />
                                <Button Grid.Column="1"
                                        Content="Clear"
                                        Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding ShowClearSearch}"
                                        AutomationProperties.Name="Clear saved book search" />
                            </Grid>
                            <TextBlock Text="{Binding SearchNote}" Classes="folium-caption folium-muted" TextWrapping="Wrap" IsVisible="{Binding ShowSavedSearch}" />
                            <Grid x:Name="SortGrid" IsVisible="{Binding ShowSortMenu}"
                                  ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="{StaticResource FoliumSpacingSm}"
                                  RowSpacing="{StaticResource FoliumSpacingSm}">
                                <Button x:Name="TitleAscendingSort"
                                        Content="Title A–Z"
                                        Classes="folium-filter"
                                        Classes.folium-primary="{Binding IsTitleAscending}"
                                        Command="{Binding SortCommand}"
                                        CommandParameter="title-asc" />
                                <Button x:Name="TitleDescendingSort"
                                        Grid.Column="1"
                                        Content="Title Z–A"
                                        Classes="folium-filter"
                                        Classes.folium-primary="{Binding IsTitleDescending}"
                                        Command="{Binding SortCommand}"
                                        CommandParameter="title-desc" />
                                <Button x:Name="AuthorAscendingSort"
                                        Grid.Row="1"
                                        Content="Author A–Z"
                                        Classes="folium-filter"
                                        Classes.folium-primary="{Binding IsAuthorAscending}"
                                        Command="{Binding SortCommand}"
                                        CommandParameter="author-asc" />
                                <Button x:Name="AuthorDescendingSort"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Content="Author Z–A"
                                        Classes="folium-filter"
                                        Classes.folium-primary="{Binding IsAuthorDescending}"
                                        Command="{Binding SortCommand}"
                                        CommandParameter="author-desc" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource FoliumSpacingSm}" IsVisible="{Binding IsEmpty}">
                            <Viewbox x:Name="EmptyIcon"
                                     Width="{StaticResource FoliumEmptyIconSize}"
                                     Height="{StaticResource FoliumEmptyIconSize}">
                                <Path Data="{StaticResource FoliumEmptyIcon}"
                                      Classes="folium-icon"
                                      Stroke="{DynamicResource FoliumPrimaryBrush}"
                                      Width="{StaticResource FoliumActionIconSize}"
                                      Height="{StaticResource FoliumActionIconSize}" />
                            </Viewbox>
                            <TextBlock Text="{Binding EmptyMessage}" Classes="folium-section" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static vm:LibraryViewModel.EmptyDetail}" TextWrapping="Wrap" />
                            <Button Content="Find a book online"
                                    Classes="folium-primary"
                                    Command="{Binding ShowSearchCommand}"
                                    AutomationProperties.Name="Find a book online"
                                    HorizontalAlignment="Stretch">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FoliumSpacingSm}">
                                            <Path Data="{StaticResource FoliumSearchIcon}"
                                                  Classes="folium-icon folium-icon-primary"
                                                  Width="{StaticResource FoliumActionIconSize}"
                                                  Height="{StaticResource FoliumActionIconSize}" />
                                            <TextBlock Text="{Binding}" Classes="folium-label" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button Content="Add a book by hand"
                                    Command="{Binding AddByHandCommand}"
                                    AutomationProperties.Name="Add a book by hand"
                                    HorizontalAlignment="Stretch" />
                            <Button Content="Restore backup"
                                    Click="RestoreBackupClick"
                                    AutomationProperties.Name="Restore backup"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <TextBlock Text="{Binding NoMatchMessage}"
                                   Classes="folium-muted"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ShowNoMatches}" />
                        <ItemsControl x:Name="LibraryBooksList" ItemsSource="{Binding ShownBooks}" IsVisible="{Binding ShowBookList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BookRow">
                                    <Button Margin="{StaticResource FoliumBottomSpacingSm}"
                                            Padding="{StaticResource FoliumSpacingMdThickness}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="{DynamicResource FoliumSurfaceBrush}"
                                            BorderBrush="{DynamicResource FoliumBorderBrush}"
                                            BorderThickness="1"
                                            Command="{Binding $parent[views:MainView].DataContext.OpenCommand}"
                                            CommandParameter="{Binding Id}"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource FoliumSpacingSm}">
                                            <Border Width="{StaticResource FoliumCoverLibraryRowWidth}"
                                                    Height="{StaticResource FoliumCoverLibraryRowHeight}"
                                                    CornerRadius="{StaticResource FoliumCoverCornerRadius}"
                                                    Background="{Binding Tone, Converter={StaticResource CoverToneBrush}}"
                                                    IsVisible="{Binding !HasCover}">
                                                <TextBlock Text="{Binding Initial}"
                                                           Classes="folium-section"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Tone, Converter={StaticResource CoverToneBrush}, ConverterParameter=ink}" />
                                            </Border>
                                            <views:LocalCover Grid.Column="0"
                                                              Width="{StaticResource FoliumCoverLibraryRowWidth}"
                                                              Height="{StaticResource FoliumCoverLibraryRowHeight}"
                                                              Bytes="{Binding Cover}"
                                                              IsVisible="{Binding HasCover}"
                                                              Stretch="UniformToFill" />
                                            <StackPanel Grid.Column="1" Spacing="{StaticResource FoliumSpacingXs}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Classes="folium-label" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Author}" Classes="folium-body" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}" Classes="folium-label-small" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="LibraryBooksGrid" ItemsSource="{Binding ShownBooks}" IsVisible="{Binding ShowBookGrid}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BookRow">
                                    <Button Margin="{StaticResource FoliumBottomSpacingSm}"
                                            Padding="{StaticResource FoliumSpacingSmThickness}"
                                            HorizontalContentAlignment="Center"
                                            Background="{DynamicResource FoliumSurfaceBrush}"
                                            BorderBrush="{DynamicResource FoliumBorderBrush}"
                                            BorderThickness="1"
                                            Command="{Binding $parent[views:MainView].DataContext.OpenCommand}"
                                            CommandParameter="{Binding Id}"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid>
                                            <Border Width="{StaticResource FoliumCoverLibraryGridWidth}"
                                                    Height="{StaticResource FoliumCoverLibraryGridHeight}"
                                                    CornerRadius="{StaticResource FoliumCoverCornerRadius}"
                                                    Background="{Binding Tone, Converter={StaticResource CoverToneBrush}}"
                                                    IsVisible="{Binding !HasCover}"
                                                    Padding="{StaticResource FoliumSpacingSmThickness}">
                                                <StackPanel Spacing="{StaticResource FoliumSpacingXs}" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Title}" Classes="folium-label" TextWrapping="Wrap"
                                                               Foreground="{Binding Tone, Converter={StaticResource CoverToneBrush}, ConverterParameter=ink}" />
                                                    <TextBlock Text="{Binding Author}" TextWrapping="Wrap"
                                                               Foreground="{Binding Tone, Converter={StaticResource CoverToneBrush}, ConverterParameter=ink}" />
                                                </StackPanel>
                                            </Border>
                                            <views:LocalCover Width="{StaticResource FoliumCoverLibraryGridWidth}"
                                                              Height="{StaticResource FoliumCoverLibraryGridHeight}"
                                                              Bytes="{Binding Cover}"
                                                              IsVisible="{Binding HasCover}"
                                                              Stretch="UniformToFill" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="{StaticResource FoliumSpacingSm}">
                    <Border IsVisible="{Binding ShowSnackbar}"
                            Margin="{StaticResource FoliumTopSpacingLg}"
                            Background="{DynamicResource FoliumInverseSurfaceBrush}"
                            CornerRadius="{StaticResource FoliumControlCornerRadius}"
                            Padding="{StaticResource FoliumSpacingMdThickness}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding SnackbarMessage}" Foreground="{DynamicResource FoliumOnInverseBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Open" Command="{Binding OpenSnackbarCommand}" Foreground="{DynamicResource FoliumInversePrimaryBrush}" Background="Transparent" />
                        </Grid>
                    </Border>
                <Button Content="Add book"
                        Command="{Binding ShowAddSheetCommand}"
                        Classes="folium-primary folium-add"
                        IsVisible="{Binding ShowSavedBookControls}"
                        AutomationProperties.Name="Add book"
                        HorizontalAlignment="Right">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource FoliumSpacingSm}">
                                <Path Data="{StaticResource FoliumAddIcon}"
                                      Classes="folium-icon folium-icon-primary"
                                      Width="{StaticResource FoliumActionIconSize}"
                                      Height="{StaticResource FoliumActionIconSize}" />
                                <TextBlock Text="{Binding}" Classes="folium-label" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                </StackPanel>
            </Grid>
            <Grid IsVisible="{Binding ShowSearch}">
                <views:SearchView DataContext="{Binding Search}" />
            </Grid>
            <ScrollViewer IsVisible="{Binding ShowEditor}">
                <StackPanel Spacing="{StaticResource FoliumSpacingMd}" Margin="{StaticResource FoliumScreenEndThickness}">
                    <TextBlock Text="Title" Classes="folium-label" />
                    <TextBox Text="{Binding TitleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Title" />
                    <TextBlock Text="Author" Classes="folium-label" />
                    <TextBox Text="{Binding AuthorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Author" />
                    <Border Classes="folium-group" IsVisible="{Binding MetadataEditor, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="{StaticResource FoliumSpacingSm}">
                        <TextBlock Text="Review metadata from Open Library" Classes="folium-section" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MetadataEditor.EditionKey}" TextWrapping="Wrap" />
                        <TextBlock Text="Publisher" Classes="folium-label" />
                        <TextBox Name="PublisherInput" Text="{Binding MetadataEditor.Publisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Publisher" />
                        <TextBlock Text="Publication date" Classes="folium-label" />
                        <TextBox Name="PublicationDateInput" Text="{Binding MetadataEditor.PublicationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Publication date" />
                        <TextBlock Text="ISBN" Classes="folium-label" />
                        <TextBox Name="IsbnInput" Text="{Binding MetadataEditor.Isbn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ISBN" />
                        <TextBlock Text="Edition" Classes="folium-label" />
                        <TextBox Name="EditionInput" Text="{Binding MetadataEditor.Edition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Edition" />
                        <TextBlock Text="Language" Classes="folium-label" />
                        <TextBox Name="LanguageInput" Text="{Binding MetadataEditor.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Language" />
                        <TextBlock Text="Description" Classes="folium-label" />
                        <TextBox Name="DescriptionInput"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="160"
                                 Text="{Binding MetadataEditor.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Description" />
                        <CheckBox Name="KeepCoverInput" IsChecked="{Binding MetadataEditor.KeepCover, Mode=TwoWay}" IsVisible="{Binding MetadataEditor.HasCover}">
                            <TextBlock Text="I have permission to save this cover on my device" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="Cover images can have separate copyright restrictions. Leave the box unchecked to save without a cover."
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding MetadataEditor.HasCover}" />
                    </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding InputError}" Classes="folium-error" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SaveError}"
                               Classes="folium-error"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SaveError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.Name="{Binding SaveError}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <Button Content="Save book"
                            Command="{Binding SaveCommand}"
                            Classes="folium-primary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
            <Grid IsVisible="{Binding ShowDetails}" RowDefinitions="*,Auto,Auto">
                <ScrollViewer Grid.Row="0">
                    <StackPanel Spacing="{StaticResource FoliumSpacingMd}" Margin="{StaticResource FoliumScreenEndThickness}">
                        <TextBlock Text="Title" Classes="folium-caption folium-muted" />
                        <TextBlock Text="{Binding SelectedTitle}" Classes="folium-section" TextWrapping="Wrap" />
                        <TextBlock Text="Author" Classes="folium-caption folium-muted" />
                        <TextBlock Text="{Binding SelectedAuthor}" TextWrapping="Wrap" />
                        <Border Width="{StaticResource FoliumCoverBookDetailsWidth}"
                                Height="{StaticResource FoliumCoverBookDetailsHeight}"
                                CornerRadius="{StaticResource FoliumCoverCornerRadius}"
                                Background="{Binding SelectedTone, Converter={StaticResource CoverToneBrush}}"
                                IsVisible="{Binding !HasSelectedCover}"
                                Padding="{StaticResource FoliumSpacingSmThickness}"
                                HorizontalAlignment="Left">
                            <StackPanel Spacing="{StaticResource FoliumSpacingXs}" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding SelectedTitle}"
                                           Classes="folium-label"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding SelectedTone, Converter={StaticResource CoverToneBrush}, ConverterParameter=ink}" />
                                <TextBlock Text="{Binding SelectedAuthor}"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding SelectedTone, Converter={StaticResource CoverToneBrush}, ConverterParameter=ink}" />
                            </StackPanel>
                        </Border>
                        <views:LocalCover Name="SavedCover"
                                          Bytes="{Binding SelectedCover}"
                                          Width="{StaticResource FoliumCoverBookDetailsWidth}"
                                          Height="{StaticResource FoliumCoverBookDetailsHeight}"
                                          Stretch="Uniform"
                                          IsVisible="{Binding HasSelectedCover}"
                                          AutomationProperties.Name="Saved book cover" />
                        <TextBlock Text="No saved cover" IsVisible="{Binding #SavedCover.Source, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                        <Border Classes="folium-group" IsVisible="{Binding HasSelectedMetadata}">
                        <StackPanel Spacing="{StaticResource FoliumSpacingSm}">
                            <TextBlock Text="Metadata from Open Library" Classes="folium-label" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedMetadata.WorkKey}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedMetadata.EditionKey}" TextWrapping="Wrap" />
                            <TextBlock Text="Publisher" Classes="folium-caption folium-muted" IsVisible="{Binding SelectedMetadata.Publisher, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedMetadata.Publisher}" TextWrapping="Wrap" IsVisible="{Binding SelectedMetadata.Publisher, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="Publication date" Classes="folium-caption folium-muted" IsVisible="{Binding SelectedMetadata.PublicationDate, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedMetadata.PublicationDate}" TextWrapping="Wrap" IsVisible="{Binding SelectedMetadata.PublicationDate, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="ISBN" Classes="folium-caption folium-muted" IsVisible="{Binding SelectedMetadata.Isbn, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedMetadata.Isbn}" TextWrapping="Wrap" IsVisible="{Binding SelectedMetadata.Isbn, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="Edition" Classes="folium-caption folium-muted" IsVisible="{Binding SelectedMetadata.Edition, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedMetadata.Edition}" TextWrapping="Wrap" IsVisible="{Binding SelectedMetadata.Edition, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="Language" Classes="folium-caption folium-muted" IsVisible="{Binding SelectedMetadata.Language, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedMetadata.Language}" TextWrapping="Wrap" IsVisible="{Binding SelectedMetadata.Language, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="Description" Classes="folium-caption folium-muted" IsVisible="{Binding SelectedMetadata.Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SelectedMetadata.Description}" TextWrapping="Wrap" IsVisible="{Binding SelectedMetadata.Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        </Border>
                        <TextBlock Text="Status" Classes="folium-caption folium-muted" />
                        <TextBlock Text="{Binding SelectedStatus}" Classes="folium-label" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource FoliumSpacingSm}">
                        <Button Grid.Column="0"
                                Content="To read"
                                Classes="folium-segment"
                                Classes.folium-primary="{Binding IsSelectedToRead}"
                                Command="{Binding SetStatusCommand}"
                                AutomationProperties.Name="To read"
                                CommandParameter="to-read"
                                HorizontalAlignment="Stretch">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource FoliumSpacingSm}">
                                        <Path Data="{StaticResource FoliumToReadIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
                                        <TextBlock Text="{Binding}" Classes="folium-label" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Grid.Column="1"
                                Content="Reading"
                                Classes="folium-segment"
                                Classes.folium-primary="{Binding IsSelectedReading}"
                                Command="{Binding SetStatusCommand}"
                                AutomationProperties.Name="Reading"
                                CommandParameter="reading"
                                HorizontalAlignment="Stretch">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource FoliumSpacingSm}">
                                        <Path Data="{StaticResource FoliumReadingIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
                                        <TextBlock Text="{Binding}" Classes="folium-label" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Grid.Column="2"
                                Content="Finished"
                                Classes="folium-segment"
                                Classes.folium-primary="{Binding IsSelectedFinished}"
                                Command="{Binding SetStatusCommand}"
                                AutomationProperties.Name="Finished"
                                CommandParameter="finished"
                                HorizontalAlignment="Stretch">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource FoliumSpacingSm}">
                                        <Path Data="{StaticResource FoliumReadIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
                                        <TextBlock Text="{Binding}" Classes="folium-label" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="1"
                           Text="{Binding SaveError}"
                           Classes="folium-error"
                           TextWrapping="Wrap"
                           Margin="{StaticResource FoliumTopSpacingLg}"
                           IsVisible="{Binding SaveError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.Name="{Binding SaveError}"
                           AutomationProperties.LiveSetting="Assertive" />
                <StackPanel Grid.Row="2" Spacing="{StaticResource FoliumSpacingSm}" Margin="{StaticResource FoliumTopSpacingLg}" IsVisible="False">
                    <Button Content="Edit"
                            Command="{Binding EditCommand}"
                            AutomationProperties.Name="Edit"
                            HorizontalAlignment="Stretch">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FoliumSpacingSm}">
                                    <Path Data="{StaticResource FoliumEditIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
                                    <TextBlock Text="{Binding}" Classes="folium-label" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Remove"
                            Command="{Binding AskRemoveCommand}"
                            Classes="folium-danger"
                            AutomationProperties.Name="Remove"
                            HorizontalAlignment="Stretch">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FoliumSpacingSm}">
                                    <Path Data="{StaticResource FoliumDeleteIcon}" Classes="folium-icon folium-icon-danger" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
                                    <TextBlock Text="{Binding}" Classes="folium-label" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel IsVisible="{Binding ShowConfirm}" Spacing="{StaticResource FoliumSpacingMd}" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedTitle}" Classes="folium-section" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConfirmMessage}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SaveError}"
                           Classes="folium-error"
                           TextWrapping="Wrap"
                           IsVisible="{Binding SaveError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.Name="{Binding SaveError}"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Content="Keep book"
                        Command="{Binding KeepBookCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Content="Delete book"
                        Command="{Binding ConfirmRemoveCommand}"
                        Classes="folium-danger"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
            <Grid IsVisible="{Binding ShowRestore}" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="{StaticResource FoliumSpacingMd}">
                <TextBlock Text="{Binding RestoreMessage}" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding RestorePreview}" TextWrapping="Wrap" />
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="{Binding SaveError}"
                           Classes="folium-error"
                           TextWrapping="Wrap"
                           IsVisible="{Binding SaveError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.Name="{Binding SaveError}"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Row="3" Content="Replace library"
                        Command="{Binding ConfirmRestoreCommand}"
                        Classes="folium-danger"
                        HorizontalAlignment="Stretch" />
                <Button Grid.Row="4" Content="Keep current library"
                        Command="{Binding KeepLibraryCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </Grid>
            <StackPanel IsVisible="{Binding ShowBackup}" Spacing="{StaticResource FoliumSpacingMd}">
                <TextBlock Text="Export backup" Classes="folium-section" />
                <TextBlock Text="Write your saved books to a file you choose. The file holds reading status, metadata and saved covers." TextWrapping="Wrap" />
                <Button Content="Export backup"
                        Click="ExportBackupClick"
                        Classes="folium-primary"
                        AutomationProperties.Name="Export backup"
                        HorizontalAlignment="Stretch" />
                <TextBlock Text="Restore backup" Classes="folium-section" />
                <TextBlock Text="Replace the books on this device with the books in a backup file. You see the titles before anything changes." TextWrapping="Wrap" />
                <Button Content="Choose backup file"
                        Click="RestoreBackupClick"
                        AutomationProperties.Name="Choose backup file"
                        HorizontalAlignment="Stretch" />
                <TextBlock Text="Folium does not upload backups. The file contains your reading history, so keep it in a private place. Folium reads version 1 backups up to 32 MiB." Classes="folium-caption folium-muted" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowLibraryMenu}" Spacing="{StaticResource FoliumSpacingSm}" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Backup and restore" Command="{Binding ShowBackupCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <Border IsVisible="{Binding ShowAddSheet}" Background="{DynamicResource FoliumScrimBrush}" Opacity="0.48">
                <Button Command="{Binding DismissAddSheetCommand}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Close add book" />
            </Border>
            <Border IsVisible="{Binding ShowAddSheet}"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource FoliumRaisedBrush}"
                    CornerRadius="{StaticResource FoliumGroupCornerRadius}"
                    Padding="{StaticResource FoliumSpacingLgThickness}">
                <StackPanel Spacing="{StaticResource FoliumSpacingSm}">
                    <TextBlock Text="Add a book" Classes="folium-section" />
                    <Button Content="Find a book online" Command="{Binding ShowSearchCommand}" Classes="folium-primary" HorizontalAlignment="Stretch" />
                    <Button Content="Add a book by hand" Command="{Binding AddByHandCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding ShowLoadError}"
                        Spacing="{StaticResource FoliumSpacingSm}">
                <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" />
                <Button Content="Restore backup" Click="RestoreBackupClick"
                        AutomationProperties.Name="Restore backup" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding SaveError}"
                           Classes="folium-error"
                           TextWrapping="Wrap"
                           IsVisible="{Binding SaveError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.Name="{Binding SaveError}"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <Button Content="Back"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding ShowBack}"
                    AutomationProperties.Name="Back"
                    MinWidth="{StaticResource FoliumTouchTargetMin}"
                    Margin="{StaticResource FoliumRightSpacingSm}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Heading}"
                       Classes="folium-title"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Command="{Binding ToggleSavedSearchCommand}"
                    IsVisible="{Binding ShowSavedBookControls}"
                    AutomationProperties.Name="Search saved books"
                    MinWidth="{StaticResource FoliumTouchTargetMin}"
                    Padding="{StaticResource FoliumSpacingSmThickness}">
                <Path Data="{StaticResource FoliumSearchIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
            </Button>
            <Button Grid.Column="3"
                    Command="{Binding ToggleGridCommand}"
                    IsVisible="{Binding ShowSavedBookControls}"
                    AutomationProperties.Name="{Binding ViewLabel}"
                    MinWidth="{StaticResource FoliumTouchTargetMin}"
                    Padding="{StaticResource FoliumSpacingSmThickness}">
                <Panel>
                    <Path x:Name="ViewGridIcon" Data="{StaticResource FoliumViewGridIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" IsVisible="{Binding !ShowGrid}" />
                    <Path x:Name="ViewListIcon" Data="{StaticResource FoliumViewListIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" IsVisible="{Binding ShowGrid}" />
                </Panel>
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding EditCommand}"
                    IsVisible="{Binding ShowDetails}"
                    AutomationProperties.Name="Edit book"
                    MinWidth="{StaticResource FoliumTouchTargetMin}"
                    Padding="{StaticResource FoliumSpacingSmThickness}">
                <Path Data="{StaticResource FoliumEditIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
            </Button>
            <Button Grid.Column="4"
                    Command="{Binding ShowLibraryMenuCommand}"
                    IsVisible="{Binding ShowLibrary}"
                    AutomationProperties.Name="More options"
                    MinWidth="{StaticResource FoliumTouchTargetMin}"
                    Padding="{StaticResource FoliumSpacingSmThickness}">
                <Path Data="{StaticResource FoliumOverflowIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
            </Button>
            <Button Grid.Column="4"
                    IsVisible="{Binding ShowDetails}"
                    AutomationProperties.Name="More options"
                    MinWidth="{StaticResource FoliumTouchTargetMin}"
                    Padding="{StaticResource FoliumSpacingSmThickness}">
                <Button.Flyout>
                    <Flyout>
                        <Button Content="Delete book"
                                Command="{Binding AskRemoveCommand}"
                                Classes="folium-danger"
                                AutomationProperties.Name="Delete book" />
                    </Flyout>
                </Button.Flyout>
                <Path Data="{StaticResource FoliumOverflowIcon}" Classes="folium-icon" Width="{StaticResource FoliumActionIconSize}" Height="{StaticResource FoliumActionIconSize}" />
            </Button>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" IsVisible="{Binding ShowTabBar}" Margin="{StaticResource FoliumTopSpacingSm}">
            <Button Content="Library"
                    Command="{Binding SelectLibraryCommand}"
                    Classes="folium-segment"
                    Classes.folium-primary="{Binding ShowLibrary}"
                    AutomationProperties.Name="Library" />
            <Button Grid.Column="1"
                    Content="Find online"
                    Command="{Binding ShowSearchCommand}"
                    Classes="folium-segment"
                    Classes.folium-primary="{Binding ShowSearch}"
                    AutomationProperties.Name="Find online" />
        </Grid>
    </Grid>
</UserControl>
