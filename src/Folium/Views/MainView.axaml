<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Folium.ViewModels"
             x:Class="Folium.Views.MainView"
             x:DataType="vm:MainViewModel">
    <TextBlock Text="{Binding Title}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
</UserControl>
