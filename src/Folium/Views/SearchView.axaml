<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Folium.ViewModels"
             xmlns:search="using:Folium.Search"
             x:Class="Folium.Views.SearchView"
             x:DataType="vm:SearchViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="{StaticResource FoliumSpacingSm}">
            <!-- The app bar shows the screen title. This heading names the edition step only. -->
            <TextBlock Text="Choose an edition" Classes="folium-section" TextWrapping="Wrap" IsVisible="{Binding ShowEditions}" />
            <StackPanel IsVisible="{Binding ShowWorks}" Spacing="{StaticResource FoliumSpacingSm}">
                <TextBox Text="{Binding Query, Mode=TwoWay}" PlaceholderText="For example, Middlemarch" AutomationProperties.Name="Title" />
                <Button Content="Search Open Library" Click="SearchClicked" Classes="folium-primary" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="{StaticResource FoliumSpacingSm}" Margin="{StaticResource FoliumVerticalSpacingSm}">
            <TextBlock Text="{Binding Message}" Classes="folium-muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
            <Button Content="Cancel search" Click="CancelClicked" IsVisible="{Binding IsBusy}" />
            <Button Content="Try again" Click="RetryClicked" IsVisible="{Binding ShowRetry}" Classes="folium-primary" />
            <StackPanel IsVisible="{Binding IsOffline}" Spacing="{StaticResource FoliumSpacingSm}">
                <TextBlock Text="No connection" Classes="folium-section" TextWrapping="Wrap" />
                <TextBlock Text="Open Library search needs a network connection. Your saved books are still on this device." TextWrapping="Wrap" />
                <Button Content="Try again" Click="RetryClicked" Classes="folium-primary" HorizontalAlignment="Stretch" />
                <Button Content="Go to Library" Click="BackClicked" HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
        <Border Name="SearchResultsFrame" Grid.Row="2" ClipToBounds="True">
        <ScrollViewer Name="SearchResults" ClipToBounds="True" Height="{Binding #SearchResultsFrame.Bounds.Height}">
            <StackPanel Spacing="{StaticResource FoliumSpacingSm}">
                <ItemsControl ItemsSource="{Binding Works}" IsVisible="{Binding ShowWorks}" IsEnabled="{Binding !IsBusy}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="search:SearchWork">
                            <Button Click="WorkClicked" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="{StaticResource FoliumBottomSpacingSm}">
                                <StackPanel Spacing="{StaticResource FoliumSpacingXs}">
                                    <TextBlock Text="{Binding Title}" Classes="folium-label" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Authors}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FirstPublished, StringFormat='First published: {0}'}" Classes="folium-caption folium-muted" />
                                    <TextBlock Text="Choose an edition →" Classes="folium-caption folium-muted" />
                                    <Image Name="ResultCover" MaxHeight="160" Stretch="Uniform" />
                                    <Button Content="Preview cover" IsVisible="{Binding HasCover}" Tag="{Binding CoverId}" Click="CoverClicked" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Editions}" IsVisible="{Binding ShowEditions}" IsEnabled="{Binding !IsBusy}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="search:SearchEdition">
                            <Button Click="EditionClicked" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="{StaticResource FoliumBottomSpacingSm}">
                                <StackPanel Spacing="{StaticResource FoliumSpacingXs}">
                                    <TextBlock Text="{Binding Title}" Classes="folium-label" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Publisher}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PublicationDate}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Edition}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Language}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Isbn, StringFormat='ISBN: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Key}" Classes="folium-caption folium-muted" />
                                    <Image Name="ResultCover" MaxHeight="160" Stretch="Uniform" />
                                    <Button Content="Preview cover" IsVisible="{Binding HasCover}" Tag="{Binding CoverId}" Click="CoverClicked" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsVisible="{Binding ShowPreview}" Spacing="{StaticResource FoliumSpacingSm}">
                    <Image Name="CoverImage" Width="{StaticResource FoliumCoverEditionPreviewWidth}" Height="{StaticResource FoliumCoverEditionPreviewHeight}" Stretch="Uniform" AutomationProperties.Name="Edition cover" />
                    <TextBlock Text="{Binding Preview.Title}" Classes="folium-section" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview.Authors, StringFormat='Authors: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview.Publisher, StringFormat='Publisher: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview.PublicationDate, StringFormat='Published: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview.Isbn, StringFormat='ISBN: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview.Edition, StringFormat='Edition: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview.Language, StringFormat='Language: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview.Description}" TextWrapping="Wrap" />
                    <TextBlock Text="Empty fields are not supplied by Open Library." Classes="folium-caption folium-muted" TextWrapping="Wrap" />
                    <Button Content="Review and save" Click="ImportClicked" IsEnabled="{Binding !IsBusy}" Classes="folium-primary" />
                    <Button Content="View edition on Open Library" Click="SourceClicked" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </Border>
        <StackPanel Name="SearchPageBar" Grid.Row="3" Spacing="{StaticResource FoliumSpacingSm}" Margin="{StaticResource FoliumTopSpacingSm}">
            <Grid ColumnDefinitions="*,*" IsVisible="{Binding !ShowPreview}">
                <Button Content="Previous page" Click="PreviousClicked" IsEnabled="{Binding HasPrevious}" />
                <Button Grid.Column="1" Content="Next page" Click="NextClicked" IsEnabled="{Binding HasNext}" />
            </Grid>
            <Button Content="Back" Click="BackClicked" HorizontalAlignment="Stretch" />
            <TextBlock Text="Metadata and covers from Open Library" Classes="folium-caption folium-muted" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
