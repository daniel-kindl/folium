<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Folium.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Folium/Styles/Theme.axaml" />
                <ResourceInclude Source="avares://Folium/Styles/Icons.axaml" />
                <ResourceInclude Source="avares://Folium/Styles/Templates.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="FoliumNotoSans">avares://Folium/Assets/Fonts#Noto Sans</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Folium/Styles/ThemeStyles.axaml" />
    </Application.Styles>
</Application>
