<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector=":is(UserControl)">
        <Setter Property="Background" Value="{DynamicResource FoliumBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumTextBrush}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FoliumNotoSans}" />
        <Setter Property="FontSize" Value="{DynamicResource FoliumBodyFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumBodyLineHeight}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.folium-caption">
        <Setter Property="FontSize" Value="{DynamicResource FoliumCaptionFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumCaptionLineHeight}" />
    </Style>
    <Style Selector="TextBlock.folium-label">
        <Setter Property="FontSize" Value="{DynamicResource FoliumLabelFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumLabelLineHeight}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.folium-section">
        <Setter Property="FontSize" Value="{DynamicResource FoliumSectionFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumSectionLineHeight}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.folium-title">
        <Setter Property="FontSize" Value="{DynamicResource FoliumTitleFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumTitleLineHeight}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.folium-muted">
        <Setter Property="Foreground" Value="{DynamicResource FoliumMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.folium-error">
        <Setter Property="Foreground" Value="{DynamicResource FoliumErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.folium-active-filter">
        <Setter Property="Foreground" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource FoliumNotoSans}" />
        <Setter Property="FontSize" Value="{DynamicResource FoliumBodyFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource FoliumTouchTargetMin}" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource FoliumRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingLgThickness}" />
    </Style>
    <Style Selector="Button.folium-primary">
        <Setter Property="Background" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumOnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumPrimaryBrush}" />
    </Style>
    <Style Selector="Button.folium-primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FoliumOnPrimaryBrush}" />
    </Style>
    <Style Selector="Button.folium-danger">
        <Setter Property="Foreground" Value="{DynamicResource FoliumErrorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumErrorBrush}" />
    </Style>
    <Style Selector="Button.folium-filter">
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingXsThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FoliumFocusThickness}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumMutedBrush}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FoliumNotoSans}" />
        <Setter Property="FontSize" Value="{DynamicResource FoliumBodyFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumBodyLineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource FoliumTouchTargetMin}" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingSmThickness}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FoliumFocusThickness}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="{StaticResource FoliumTouchTargetMin}" />
    </Style>
    <Style Selector="Path.folium-icon">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.folium-icon-primary">
        <Setter Property="Stroke" Value="{DynamicResource FoliumOnPrimaryBrush}" />
    </Style>
    <Style Selector="Path.folium-icon-danger">
        <Setter Property="Stroke" Value="{DynamicResource FoliumErrorBrush}" />
    </Style>
    <Style Selector="Border.folium-group">
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumGroupCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingLgThickness}" />
    </Style>
</Styles>
