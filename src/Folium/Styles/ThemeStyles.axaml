<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector=":is(UserControl)">
        <Setter Property="Background" Value="{DynamicResource FoliumBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumTextBrush}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FoliumNotoSans}" />
        <Setter Property="FontSize" Value="{DynamicResource FoliumBodyFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumBodyLineHeight}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.folium-caption">
        <Setter Property="FontSize" Value="{DynamicResource FoliumCaptionFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumCaptionLineHeight}" />
    </Style>
    <Style Selector="TextBlock.folium-label">
        <Setter Property="FontSize" Value="{DynamicResource FoliumLabelFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumLabelLineHeight}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.folium-label-small">
        <Setter Property="FontSize" Value="{DynamicResource FoliumLabelSmallFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumLabelSmallLineHeight}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.folium-section">
        <Setter Property="FontSize" Value="{DynamicResource FoliumSectionFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumSectionLineHeight}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.folium-title">
        <Setter Property="FontSize" Value="{DynamicResource FoliumTitleFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumTitleLineHeight}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.folium-muted">
        <Setter Property="Foreground" Value="{DynamicResource FoliumMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.folium-error">
        <Setter Property="Foreground" Value="{DynamicResource FoliumErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.folium-active-filter">
        <Setter Property="Foreground" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource FoliumNotoSans}" />
        <Setter Property="FontSize" Value="{DynamicResource FoliumBodyFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource FoliumTouchTargetMin}" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource FoliumRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingLgThickness}" />
    </Style>
    <Style Selector="Button.folium-primary">
        <Setter Property="Background" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumOnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumPrimaryBrush}" />
    </Style>
    <Style Selector="Button.folium-primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FoliumOnPrimaryBrush}" />
    </Style>
    <Style Selector="Button.folium-danger">
        <Setter Property="Foreground" Value="{DynamicResource FoliumErrorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumErrorBrush}" />
    </Style>
    <Style Selector="Button.folium-filter">
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingXsThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumFocusBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FoliumFocusThickness}" />
        <Setter Property="Margin" Value="{StaticResource FoliumFocusGapThickness}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource FoliumRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumDisabledTextBrush}" />
    </Style>
    <Style Selector="Button TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>
    <Style Selector="Button.folium-segment">
        <Setter Property="FontSize" Value="{DynamicResource FoliumLabelSmallFontSize}" />
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingXsThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource FoliumTouchTargetMin}" />
    </Style>
    <Style Selector="Button.folium-segment.folium-primary">
        <Setter Property="Background" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumOnPrimaryBrush}" />
    </Style>
    <Style Selector="Button.folium-segment Path.folium-check">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.folium-segment.folium-primary Path.folium-check">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.folium-add">
        <Setter Property="MinHeight" Value="{StaticResource FoliumAddButtonHeight}" />
        <Setter Property="Height" Value="{StaticResource FoliumAddButtonHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource FoliumAddButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumGroupCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingLgThickness}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FoliumNotoSans}" />
        <Setter Property="FontSize" Value="{DynamicResource FoliumBodyFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FoliumBodyLineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource FoliumTouchTargetMin}" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingSmThickness}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumFocusBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FoliumFocusThickness}" />
        <Setter Property="Margin" Value="{StaticResource FoliumFocusGapThickness}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumBorderBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumFocusBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FoliumFocusThickness}" />
    </Style>
    <Style Selector="TextBox:focus:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumFocusBrush}" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource FoliumDisabledTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource FoliumRaisedBrush}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="{StaticResource FoliumTouchTargetMin}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumTextBrush}" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
    </Style>
    <Style Selector="CheckBox:pressed /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource FoliumOnPrimaryBrush}" />
    </Style>
    <Style Selector="Path.folium-icon">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{DynamicResource FoliumTextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.folium-icon-primary">
        <Setter Property="Stroke" Value="{DynamicResource FoliumOnPrimaryBrush}" />
    </Style>
    <Style Selector="Path.folium-icon-danger">
        <Setter Property="Stroke" Value="{DynamicResource FoliumErrorBrush}" />
    </Style>
    <Style Selector="Border.folium-group">
        <Setter Property="Background" Value="{DynamicResource FoliumSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumGroupCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingLgThickness}" />
    </Style>
    <Style Selector="Button.folium-add.folium-compact TextBlock.folium-add-label">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.folium-text">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingSmThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource FoliumPrimaryBrush}" />
    </Style>
    <Style Selector="Button.folium-icon-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="{StaticResource FoliumTouchTargetMin}" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingMdThickness}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.folium-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,12" />
    </Style>
    <Style Selector="Button.folium-tile">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingXsThickness}" />
    </Style>
    <Style Selector="Button.folium-tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingXsThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.folium-tab:disabled">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.folium-tab:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.folium-tab-pill">
        <Setter Property="Padding" Value="20,4" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumGroupCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.folium-tab.folium-selected Border.folium-tab-pill">
        <Setter Property="Background" Value="{DynamicResource FoliumSelectedContainerBrush}" />
    </Style>
    <Style Selector="Button.folium-tab.folium-selected Path.folium-icon">
        <Setter Property="Stroke" Value="{DynamicResource FoliumPrimaryBrush}" />
    </Style>
    <Style Selector="Button.folium-tab.folium-selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FoliumPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.folium-dialog">
        <Setter Property="Background" Value="{DynamicResource FoliumRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FoliumDialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FoliumGroupCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource FoliumSpacingXlThickness}" />
    </Style>
    <Style Selector="StackPanel.folium-status-to-read TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FoliumStatusToReadBrush}" />
    </Style>
    <Style Selector="StackPanel.folium-status-to-read Path.folium-icon">
        <Setter Property="Stroke" Value="{DynamicResource FoliumStatusToReadBrush}" />
    </Style>
    <Style Selector="StackPanel.folium-status-reading TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FoliumStatusReadingBrush}" />
    </Style>
    <Style Selector="StackPanel.folium-status-reading Path.folium-icon">
        <Setter Property="Stroke" Value="{DynamicResource FoliumStatusReadingBrush}" />
    </Style>
    <Style Selector="StackPanel.folium-status-finished TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FoliumStatusFinishedBrush}" />
    </Style>
    <Style Selector="StackPanel.folium-status-finished Path.folium-icon">
        <Setter Property="Stroke" Value="{DynamicResource FoliumStatusFinishedBrush}" />
    </Style>
    <!-- After the base Path.folium-icon style, so a selected segment draws its icons in the on-primary color. -->
    <Style Selector="Button.folium-segment.folium-primary Path.folium-icon">
        <Setter Property="Stroke" Value="{DynamicResource FoliumOnPrimaryBrush}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="{StaticResource FoliumTouchTargetMin}" />
        <Setter Property="FontFamily" Value="{StaticResource FoliumNotoSans}" />
        <Setter Property="FontSize" Value="{DynamicResource FoliumBodyFontSize}" />
    </Style>
</Styles>
